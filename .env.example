[TEMPLATE]
# LLM Configuration (Groq / any OpenAI-compatible API)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# Search Configuration (Google CSE, optional)
SEARCH_API_KEY=
SEARCH_ENGINE_ID=
SEARCH_BASE_URL=https://www.googleapis.com/customsearch/v1

# NLI Configuration
NLI_MODEL=ynie/roberta-large-snli_mnli_fever_anli_R1_R2_R3-nli
NLI_DEVICE=cpu
NLI_MODE=mock
NLI_MAX_CLAIMS=3

# Debate Configuration
DISAGREEMENT_THRESHOLD=0.70
ENTAILMENT_THRESHOLD=0.70
MAX_DEBATE_ROUNDS=3
MAX_SEARCH_RESULTS=5
ALLOW_RULE_FALLBACK=true

# Application
DEMO_MODE=false
LOG_LEVEL=INFO

# Gemini (AI Answer Agent, primary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=20

# OpenCode CLI (AI Answer Agent, fallback when Gemini fails)
OPENCODE_MODEL=opencode/deepseek-v4.1-flash-free
OPENCODE_TIMEOUT=45

# OpenCode CLI (Reference Agent fill-in when Wikipedia is unavailable)
OPENCODE_WIKI_MODEL=opencode/mimo-v2.6-flash-free

# OpenCode CLI (Web Agent fill-in when DuckDuckGo is unavailable)
OPENCODE_WEB_MODEL=opencode/space-bunny-free

# OpenCode CLI (Scholarly Agent fallback when Crossref is unavailable;
# leave empty to use OPENCODE_MODEL)
OPENCODE_SCHOLARLY_MODEL=
